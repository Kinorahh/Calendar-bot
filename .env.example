# Copy to .env locally, or set these in Railway Variables.

DISCORD_TOKEN=
# Optional: register slash commands to one guild instantly while developing
# GUILD_ID=123456789012345678

# IANA timezone used for week boundaries and the Monday post
TIMEZONE=America/New_York

# Hour (0-23) in TIMEZONE when the weekly snapshot posts each Monday
WEEKLY_POST_HOUR=9

# Role names that can manage events (comma-separated). Server admins always can.
ADMIN_ROLE_NAMES=Admin,Moderator,Mod,Calendar Admin

# SQLite path — on Railway mount a volume at /data and keep this default
DATABASE_PATH=/data/calendar.db
