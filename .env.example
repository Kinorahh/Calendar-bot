# Copy to .env locally, or set these in Railway Variables.

DISCORD_TOKEN=
# Recommended: your Discord server ID (Developer Mode → right-click server → Copy Server ID)
# Registers commands to that server only (instant updates, no duplicate /commands).
# Digits only, no quotes.
# GUILD_ID=123456789012345678
#
# Leave GUILD_ID unset only if the bot should work in many servers (global commands, slower to update).

# Channel used only for /create match and match ping announcements.
# Digits only, no quotes. Right-click channel → Copy Channel ID (Developer Mode).
# MATCH_CHANNEL_ID=123456789012345678

# IANA timezone used for week boundaries and the Monday post
TIMEZONE=America/New_York

# Hour (0-23) in TIMEZONE when the weekly snapshot posts each Monday
WEEKLY_POST_HOUR=9

# Role names that can manage events (comma-separated). Server admins always can.
ADMIN_ROLE_NAMES=Admin,Moderator,Mod,Calendar Admin

# --- Database ---
# On Railway: add a PostgreSQL plugin and set DATABASE_URL (usually via Variable Reference).
# DATABASE_URL=postgresql://user:pass@host:port/railway
#
# Local/dev without Postgres: leave DATABASE_URL unset and use SQLite:
# DATABASE_PATH=./data/calendar.db
